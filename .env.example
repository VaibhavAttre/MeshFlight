MESHFLIGHT_ENV=development
MESHFLIGHT_ARTIFACTS_DIR=./artifacts
MESHFLIGHT_SCENARIOS_DIR=./artifacts/scenarios
MESHFLIGHT_RUNS_DIR=./artifacts/runs

API_HOST=127.0.0.1
API_PORT=8000

EDITOR_UI_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_S=300

GEMINI_API_KEY=
